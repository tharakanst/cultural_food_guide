# Copy to backend/.env and fill in. .env is gitignored — never commit real values.

# OpenAI API key. Read only by the service layer, never sent to the client.
# Billed per token: unlike the previous free tier, a runaway test loop costs
# real money. See the rate limiter in src/middleware/rateLimit.ts.
OPENAI_API_KEY=

# Gemini API key. Free tier — get one from Google AI Studio
# (https://aistudio.google.com/apikey). Only read when AI_PROVIDER=gemini,
# but harmless to set either way.
GEMINI_API_KEY=

# Which AI provider analyzeImage() calls: 'openai' or 'gemini'. Lets you
# switch providers without a code change — useful when the shared OpenAI
# account hits its quota and you want to fall back to Gemini's free tier (or
# back again) without redeploying. Defaults to 'openai' when unset.
AI_PROVIDER=openai

# Port the backend listens on.
PORT=4000

# Origin allowed by CORS. The Vite dev server default.
FRONTEND_ORIGIN=http://localhost:5173
