        <!-- ===================== EXTERNAL LAYER / DATA SOURCES ===================== -->
        <mxCell id="extGemini" value="Gemini Flash API&#10;DATA SOURCE: AI-generated ingredients,&#10;allergens &amp; cultural context — inferred from&#10;the photo, not fact-checked against a source" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="150" y="700" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="extWikimedia" value="Wikimedia Commons API&#10;DATA SOURCE: third-party reference photo,&#10;matched by dish name (may be wrong or absent,&#10;no key required)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
