        </mxCell>
        <mxCell id="edgeImgExt" value="dish name →&#10;← matching photo URL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="compImageService" target="extWikimedia">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===================== NO-PERSISTENCE NOTE ===================== -->
        <mxCell id="noteNoPersistence" value="No database anywhere in this system. The uploaded photo is held in memory for the duration of one request and discarded once the response is sent. No accounts, location, or identifiers are collected — every field in the result is either (a) generated fresh by Gemini from that one photo, or (b) fetched live from Wikimedia. Nothing about a user or their photo outlives the request." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;size=16;" vertex="1" parent="1">
          <mxGeometry x="150" y="810" width="700" height="80" as="geometry" />
        </mxCell>

        <!-- ===================== SHARED TYPES ===================== -->
        <mxCell id="compSharedTypes" value="shared/types.ts&#10;(AnalyzeRequest, AnalyzeResponse, ApiError —&#10;imported by both sides, no runtime values)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="960" y="330" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="edgeSharedFront" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=none;startArrow=none;" edge="1" parent="1" source="compSharedTypes" target="layerPresentation">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edgeSharedApi" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=none;startArrow=none;" edge="1" parent="1" source="compSharedTypes" target="layerApi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===================== NEWLY ADDED: ON-DEVICE-ONLY FLOWS (teal) =====================
             Missing from the original diagram: both are real data flows verified in code
             (frontend/vite.config.ts, FoodResult.tsx) that never leave the browser. -->
        <mxCell id="compServiceWorker" value="Service Worker — Workbox&#10;(vite-plugin-pwa, registerType: autoUpdate)&#10;precaches the app shell (JS/CSS/HTML/icons) into&#10;Cache Storage. /api/* is denylisted — an analyze&#10;response must never be served from cache." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d0e0e3;strokeColor=#76a5af;" vertex="1" parent="1">
          <mxGeometry x="960" y="150" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="edgeSW" value="install → precache shell&#10;(no photos, no responses)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="layerPresentation" target="compServiceWorker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="compWebSpeech" value="Web Speech API&#10;(browser built-in, SpeechSynthesisUtterance)&#10;FoodResult.tsx reads recipe steps aloud.&#10;Entirely on-device — no network call, no&#10;text ever leaves the browser." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d0e0e3;strokeColor=#76a5af;" vertex="1" parent="1">
          <mxGeometry x="960" y="440" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="edgeSpeech" value="recipe/result text →&#10;← spoken audio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="compResult" target="compWebSpeech">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Solid arrow = data/call flow (with what travels each way)    Dashed line = shared type contract, no runtime coupling    Purple note = data lifecycle / privacy    Teal box = added: on-device only, never touches the network" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
